# Copy to `.env` and fill in. Restart Expo after changes.

# Mapbox Search — public token starting with pk.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Anthropic (dev only; proxy via backend in production)
EXPO_PUBLIC_CLAUDE_API_KEY=

# Optional — production API (e.g. https://your-service.onrender.com)
# EXPO_PUBLIC_API_BASE_URL=
